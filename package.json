{
  "name": "runs-locally-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Narrated, word-synced explainer videos from a JSON script: Remotion + Kokoro TTS + whisper.cpp, all on your own machine.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/stage.mjs --all && remotion studio",
    "new": "node scripts/new.mjs",
    "make": "node scripts/make.mjs",
    "stage": "node scripts/stage.mjs",
    "check": "node scripts/check.mjs",
    "render": "node scripts/render.mjs",
    "frames": "node scripts/frames.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/cues.test.mjs scripts/system-safeguards.test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.504",
    "@remotion/cli": "4.0.504",
    "@remotion/google-fonts": "4.0.504",
    "@remotion/install-whisper-cpp": "4.0.504",
    "@remotion/renderer": "4.0.504",
    "@remotion/transitions": "4.0.504",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.504"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.6.3"
  }
}
